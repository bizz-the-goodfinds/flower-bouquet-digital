# Site
NEXT_PUBLIC_SITE_URL=https://flower-bouquet-digital.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only used by scripts/migrate.mjs (session pooler, Singapore). Not needed on Vercel.
SUPABASE_DB_URL=

# Salt for hashing IPs used in rate limiting
IP_HASH_SALT=

# Analytics
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: Cloudflare Turnstile (captcha). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: show "Continue with Google" (enable the Google provider in Supabase first)
NEXT_PUBLIC_AUTH_GOOGLE=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Protects /api/cron/reveals (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Optional: signs voice note storage paths (defaults to the service role key)
VOICE_SIGNING_SECRET=
